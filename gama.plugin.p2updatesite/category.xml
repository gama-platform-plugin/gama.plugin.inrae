<?xml version="1.0" encoding="UTF-8"?>
<site>
    <description name="GAMA Update Site">
        Site containing updates to the GAMA platform software (see http://gama-platform.org)
    </description>

    <!--
        Add one <feature> entry per feature in this repo.
        Available categories:
            gama.optional              - Generic optional components (default)
            gama.optional.connectors   - Bridges to external software (R, MATLAB, MPI...)
            gama.optional.formats      - New file format support (IFC, NetCDF, CIM...)
            gama.optional.ia           - Artificial intelligence components
    -->
    <feature url="features/gama.experimental.feature.argumentation_2025.6.0.qualifier.jar"
             id="gama.experimental.feature.argumentation"
             version="2025.6.0.qualifier">
        <category name="gama.optional"/>
